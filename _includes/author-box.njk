{#- Author box, variant D: "How I tested this app" next to the photo, after the summary.
    Values come from how_tested and measurements in the frontmatter (post.howTested.fields). An empty required field
    shows [CONFIRM] on a draft; a published app review can't have one (checkTemplate requires device, ios,
    app_version, started and ended). Check-ins and the measurements show only when filled in.
    Copy: name and jobTitle from about/index.njk; the method line from How I Review "Why are my reviews different?". -#}
{%- set f = post.howTested.fields if post.howTested else {} %}
{%- set confirmMark = '<mark class="rounded-sm bg-yellow-200 px-1 text-black box-decoration-clone">[CONFIRM]</mark>' %}
        <section class="mt-4 rounded-card border border-card-border bg-card px-[1.4rem] py-[1.35rem]" aria-labelledby="author-box-heading" id="author-box" data-author-box="d">
          <h2 id="author-box-heading" class="text-h4 font-bold tracking-h4">How I tested this app</h2>
          <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
            <div class="flex items-center gap-3 sm:w-40 sm:shrink-0 sm:flex-col sm:items-start">
              {% set avatarClass = "h-14 w-14" %}{% include "author-avatar.njk" %}
              <div class="min-w-0 text-micro leading-micro">
                <p><a class="font-semibold text-fg no-underline hover:underline" href="../../about/" rel="author">Mark Stepchin</a></p>
                <p class="text-muted">Founder of Recomp</p>
              </div>
            </div>
            <dl class="grid min-w-0 flex-1 grid-cols-[minmax(0,auto)_minmax(0,1fr)] gap-x-4 gap-y-1.5 text-micro leading-micro">
              <dt class="text-muted">Device</dt><dd class="text-fg">{{ f.device or (confirmMark | safe) }}</dd>
              <dt class="text-muted">iOS</dt><dd class="text-fg">{{ f.ios or (confirmMark | safe) }}</dd>
              <dt class="text-muted">App version</dt><dd class="text-fg">{{ f.appVersion or (confirmMark | safe) }}</dd>
              <dt class="text-muted">Test dates</dt><dd class="text-fg">{{ f.dates or (confirmMark | safe) }}</dd>
{%- if f.checkins or post.draft %}
              <dt class="text-muted">Check-ins</dt><dd class="text-fg">{{ f.checkins or (confirmMark | safe) }}</dd>
{%- endif %}
{%- if f.checkin %}
              <dt class="text-muted">One check-in</dt><dd class="text-fg">{{ f.checkin }}</dd>
{%- endif %}
{%- if f.import %}
              <dt class="text-muted">Bulk import</dt><dd class="text-fg">{{ f.import }}</dd>
{%- endif %}
            </dl>
          </div>
          <p class="mt-4 text-micro text-muted">I use real photos and weights from my fitness transformation. <a class="text-muted" href="/blog/how-i-test-progress-photo-apps/">How I review apps</a></p>
        </section>
