{#- MailCheap-style marks: thin check (has), dash (partial), cross (missing), question (not checked). Colour comes from .sc-status in input.css. -#}
{%- if r.status == "has" -%}
<svg class="size-[14px]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-7" /></svg>
{%- elif r.status == "partial" -%}
<svg class="size-[14px]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 8h8" /></svg>
{%- elif r.status == "missing" -%}
<svg class="size-[14px]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 5l6 6M11 5l-6 6" /></svg>
{%- else -%}
<svg class="size-[14px]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6" /><path d="M6.3 6.2a1.8 1.8 0 1 1 2.4 1.7c-.5.2-.7.6-.7 1.1M8 11.3v.2" /></svg>
{%- endif -%}
