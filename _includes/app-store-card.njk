{#- App Store card (v2: card with Apple's official "Download on the App Store" badge, black in light mode, white in dark).
    Data: post.appStore from app_store frontmatter (_config/blog.js appStoreData). Divs and spans,
    not <p>, so the post's prose wrapper styles ([&_p]:text-muted) don't reach inside. -#}
<aside class="rounded-card border border-card-border bg-card p-4 sm:p-5" aria-label="{{ app.name }} on the App Store">
  <div class="flex items-center gap-4">
    <img class="size-[72px] shrink-0 rounded-[16px] border border-card-border" src="{{ root }}{{ app.icon }}" alt="" width="72" height="72" loading="lazy" decoding="async" />
    <div class="min-w-0 flex-1">
      <div class="text-[1.125rem] font-bold leading-snug tracking-h4 text-fg">{{ app.name }}</div>
      <div class="mt-0.5 text-micro leading-snug text-muted">{{ app.developer }}</div>
      <span class="mt-2 inline-block rounded-full border border-card-border px-2 py-1 text-[12px] font-medium leading-none text-muted">iOS {{ app.minIos }}+</span>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-card-border pt-4">
    <div class="flex items-center gap-3">
      <span class="text-[2rem] font-bold leading-none tracking-h4 text-fg" aria-hidden="true">{{ app.ratingText }}</span>
      <span class="flex flex-col gap-1.5 text-helper leading-none text-muted" aria-hidden="true">
        {% include "app-store-stars.njk" %}
        <span>{{ app.ratingCountShort }} ratings</span>
      </span>
      <span class="sr-only">Rated {{ app.ratingText }} out of 5 from {{ app.ratingCountFull }} ratings on the US App Store, checked {{ app.checkedLong }}.</span>
    </div>
    <a class="shrink-0 rounded-[10px] transition-opacity duration-150 hover:opacity-80" href="{{ app.url }}" target="_blank" rel="noopener noreferrer" aria-label="Download {{ app.name }} on the App Store">
      <img class="hidden h-auto w-[140px] light:block" src="{{ root }}assets/download-on-the-app-store-black.svg" alt="" width="140" height="47" />
      <img class="h-auto w-[140px] light:hidden" src="{{ root }}assets/download-on-the-app-store-white.svg" alt="" width="140" height="47" />
    </a>
  </div>
  <div class="mt-3 text-[12px] leading-snug text-muted" aria-hidden="true">US App Store rating, checked {{ app.checkedLong }}.</div>
</aside>
