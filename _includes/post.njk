<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <!-- chrome:theme -->
    <!-- /chrome:theme -->
    <!-- Built by Eleventy from index.md in this post's folder. Edit index.md, then run npm run build. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ post.seoTitle }}</title>
    <meta name="description" content="{{ post.description }}" />
{% if post.noindex %}    <meta name="robots" content="noindex" />
{% endif %}    <link rel="stylesheet" href="../../styles/output.css" />
    <link rel="canonical" href="{{ post.url }}" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Recomp" />
    <meta property="og:title" content="{{ post.title }}" />
    <meta property="og:description" content="{{ post.description }}" />
    <meta property="og:url" content="{{ post.url }}" />
    <meta property="og:image" content="{% ogImage post %}" />
{% if post.published %}    <meta property="article:published_time" content="{{ post.published }}" />
{% endif %}{% if post.updated %}    <meta property="article:modified_time" content="{{ post.updated }}" />
{% endif %}    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ post.title }}" />
    <meta name="twitter:description" content="{{ post.description }}" />
    <link rel="icon" href="../../assets/recomp-app-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="../../assets/recomp-app-icon.png" />
    <script type="application/ld+json">
{{ post | jsonLd | safe }}
    </script>
  </head>
  <body class="bg-bg font-sans text-body leading-body text-fg transition-[background-color,color,border-color] duration-300 ease-[ease]">
    <div class="flex min-h-dvh flex-col">
      <!-- chrome:header current="blog" depth="2" -->
      <!-- /chrome:header -->

      <main class="mx-auto w-full max-w-[800px] flex-1 px-gutter py-12">
        <p class="text-micro text-muted pb-3">
          <a class="text-muted" href="../">Blog</a>
{% if post.breadcrumb %}          · {{ post.breadcrumb }}
{% endif %}{% if post.draft %}          · <mark class="rounded-sm bg-yellow-200 px-1 text-black box-decoration-clone">[DRAFT: noindex, not published]</mark>
{% endif %}        </p>
        <h1 class="text-h2 font-bold tracking-h2 text-balance pb-4">{{ post.title }}</h1>
        <p class="pb-6"><em>By <a class="text-muted" href="../../about/" rel="author">Mark Stepchin</a>{% if post.published %} · Published {{ post.publishedShort }}.{% endif %}{% if post.tested %} Tested {{ post.tested }}.{% endif %}</em></p>
{% if post.summary %}        <aside
          class="rounded-card border border-card-border bg-card px-[1.4rem] py-[1.35rem]"
          aria-labelledby="summary-heading"
        >
          <h2 id="summary-heading" class="text-h4 font-bold tracking-h4">
            {{ post.summaryHeading }}
          </h2>
          <div class="mt-3 text-muted">{{ post.summary | md | safe }}</div>
        </aside>
{% endif %}
        <div
          class="[&>*+*]:mt-[1em] [&_h2]:mt-[2.25em] [&_h2]:text-h3 [&_h2]:tracking-h3 [&_h2]:font-bold [&_h3]:mt-[1.75em] [&_h3]:text-[1.0625rem] [&_h3]:leading-[1.35] [&_h3]:tracking-h4 [&_h3]:font-bold [&_p]:text-muted [&_li]:text-muted [&_strong]:text-fg [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 pt-4"
        >
{{ content | safe }}
        </div>
{% if post.cta %}
        <section
          class="rounded-card border border-card-border bg-card px-[1.4rem] py-[1.35rem] mt-12"
          aria-labelledby="article-cta-heading"
        >
          <h2 id="article-cta-heading" class="text-h3 font-bold tracking-h3">
            {{ post.cta.heading }}
          </h2>
          <p class="pt-3 text-muted">
            {{ post.cta.text }}
          </p>
          <p class="pt-6">
            <a
              class="inline-flex no-underline transition-opacity duration-150 hover:no-underline hover:opacity-[0.92] focus-visible:no-underline focus-visible:opacity-[0.92] active:opacity-[0.85]"
              href="https://apps.apple.com/us/app/recomp-progress-photo-tracker/id6760444125"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Download on the App Store"
              data-cta-location="{{ post.cta.location }}"
            >
              <img
                class="hidden h-auto w-[140px] light:block"
                src="../../assets/download-on-the-app-store-black.svg"
                alt=""
                width="140"
                height="47"
              />
              <img
                class="h-auto w-[140px] light:hidden"
                src="../../assets/download-on-the-app-store-white.svg"
                alt=""
                width="140"
                height="47"
              />
            </a>
          </p>
        </section>
{% endif %}
      </main>

      <!-- chrome:footer depth="2" -->
      <!-- /chrome:footer -->
    </div>
    <script src="../../js/posthog.js"></script>
    <script src="../../js/theme.js"></script>
  </body>
</html>
