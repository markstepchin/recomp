{#- Review scorecard. Data: post.scorecard (_config/scorecard.js scorecardData).
    A real <table>: caption, column headers, one tbody per group with a rowgroup header,
    a row header per criterion. Icons are decorative; the visible label carries the meaning.
    Divs and spans, not <p>, so the prose wrapper's [&_p]:text-muted doesn't reach inside. -#}
{%- set sc = post.scorecard -%}
<section class="mt-12" aria-labelledby="scorecard-heading">
  <h2 id="scorecard-heading">{{ post.appStore.shortName or post.appStore.name }} against my checklist</h2>
  <div class="mt-2 text-muted">Each row is one thing I check in every app. The criteria come from <a href="/blog/how-i-test-progress-photo-apps/">How I review progress photo apps</a>.</div>
  <div class="-mx-gutter mt-4 overflow-x-auto overscroll-x-contain px-gutter" role="region" aria-labelledby="scorecard-caption" tabindex="0">
    <table class="scorecard w-full border-collapse text-left">
      <caption id="scorecard-caption" class="sr-only">What {{ post.appStore.name }} has, checked against my review criteria</caption>
      <colgroup><col class="w-[42%]" /><col /></colgroup>
      <thead>
        <tr>
          <th scope="col" class="border-b border-card-border px-3 py-2 text-micro font-semibold text-muted">What I check</th>
          <th scope="col" class="border-b border-card-border px-3 py-2 text-micro font-semibold text-fg">{{ post.appStore.name }}</th>
        </tr>
      </thead>
      {%- for g in sc.groups %}
      <tbody>
        <tr>
          <th scope="rowgroup" colspan="2" class="bg-card px-3 pb-2 pt-5 text-[1.0625rem] font-bold tracking-h4 text-fg">
            <a class="text-fg no-underline hover:underline" href="/blog/how-i-test-progress-photo-apps/#{{ g.anchor }}">{{ g.label }}</a>
          </th>
        </tr>
        {%- for r in g.rows %}
        <tr id="sc-{{ r.id | replace('_', '-') }}">
          <th scope="row" class="border-b border-card-border px-3 py-3 align-top text-micro font-normal text-fg">{{ r.label }}</th>
          <td class="border-b border-card-border px-3 py-3 align-top text-micro" data-status="{{ r.status }}">
            <span class="sc-status inline-flex items-center gap-1.5 font-semibold">
              {%- include "scorecard-icon.njk" %}<span>{{ r.statusLabel }}</span>
            </span>
            {%- if r.status == "confirm" %}
            <span class="block"><mark class="rounded-sm bg-yellow-200 px-1 text-black box-decoration-clone">[CONFIRM]</mark></span>
            {%- else %}
            <span class="block pt-0.5 text-muted">{{ r.fact }}</span>
            {%- endif %}
          </td>
        </tr>
        {%- endfor %}
      </tbody>
      {%- endfor %}
    </table>
  </div>
  <div class="mt-3 text-helper text-muted">
    Checked {% if post.updated %}on {{ post.updatedShort }}{% elif post.published %}on {{ post.publishedShort }}{% endif %}{% if post.howTested.appVersion %} with {{ post.appStore.shortName or post.appStore.name }} {{ post.howTested.appVersion }}{% endif %}.
    {%- if sc.hidden and not post.draft %} Rows I haven't checked yet are left out.{% endif %}
  </div>
</section>
