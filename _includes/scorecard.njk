{#- Review scorecard. Data: post.scorecard (_config/scorecard.js scorecardData).
    A real <table>: caption, column headers, one tbody per group with a rowgroup header,
    a row header per criterion. Icons are decorative; the visible label carries the meaning.
    Divs and spans, not <p>, so the prose wrapper's [&_p]:text-muted doesn't reach inside. -#}
{%- set sc = post.scorecard -%}
<section class="mt-12" aria-labelledby="scorecard-heading">
  <h2 id="scorecard-heading">{{ post.appStore.shortName or post.appStore.name }} against my checklist</h2>
  <div class="mt-2 text-muted">Each row is one thing I check in every app. The criteria come from <a href="/blog/how-i-test-progress-photo-apps/">How I review progress photo apps</a>.</div>
  <div class="mt-5 overflow-x-auto overscroll-x-contain rounded-2xl border border-card-border bg-card" role="region" aria-labelledby="scorecard-caption" tabindex="0">
    <table class="scorecard w-full border-collapse text-left text-[14px] leading-[1.4]">
      <caption id="scorecard-caption" class="sr-only">What {{ post.appStore.name }} has, checked against my review criteria</caption>
      <colgroup><col class="w-[45%]" /><col /></colgroup>
      <thead>
        <tr>
          <th scope="col" class="border-b border-card-border px-6 py-[18px] align-middle text-[13px] font-normal text-muted">What I check</th>
          <th scope="col" class="border-b border-card-border px-6 py-[18px] align-middle font-semibold text-fg">
            <span class="inline-flex items-center gap-3 rounded-[10px] border border-card-border bg-card py-1 pl-1 pr-3">
              <img class="size-6 shrink-0 rounded-[6px]" src="{{ root }}{{ post.appStore.icon }}" alt="" width="24" height="24" loading="lazy" decoding="async" />
              <span>{{ post.appStore.shortName or post.appStore.name }}</span>
            </span>
          </th>
        </tr>
      </thead>
      {%- for g in sc.groups %}
      <tbody>
        <tr>
          <th scope="rowgroup" colspan="2" class="border-b border-card-border px-6 pb-2.5 pt-6 text-[12px] font-semibold uppercase tracking-wide text-muted">
            <a class="text-muted no-underline hover:underline" href="/blog/how-i-test-progress-photo-apps/#{{ g.anchor }}">{{ g.label }}</a>
          </th>
        </tr>
        {%- for r in g.rows %}
        <tr id="sc-{{ r.id | replace('_', '-') }}">
          <th scope="row" class="border-b border-card-border px-6 py-4 align-top font-normal text-fg">{{ r.label }}</th>
          <td class="border-b border-card-border px-6 py-4 align-top" data-status="{{ r.status }}">
            <span class="flex items-start gap-3">
              <span class="sc-status mt-[0.2em] flex size-[14px] shrink-0 items-center justify-center">{%- include "scorecard-icon.njk" %}</span>
              <span class="sr-only">{{ r.statusLabel }}:</span>
              {%- if r.status == "confirm" %}
              <span class="sc-fact"><mark class="rounded-sm bg-yellow-200 px-1 text-black box-decoration-clone">[CONFIRM]</mark></span>
              {%- else %}
              <span class="sc-fact">{{ r.fact }}</span>
              {%- endif %}
            </span>
          </td>
        </tr>
        {%- endfor %}
      </tbody>
      {%- endfor %}
    </table>
  </div>
  <div class="mt-3 text-helper text-muted">
    Checked {% if post.updated %}on {{ post.updatedShort }}{% elif post.published %}on {{ post.publishedShort }}{% endif %}{% if post.howTested.appVersion %} with {{ post.appStore.shortName or post.appStore.name }} {{ post.howTested.appVersion }}{% endif %}.
    {%- if sc.hidden and not post.draft %} Rows I haven't checked yet are left out.{% endif %}
  </div>
</section>
